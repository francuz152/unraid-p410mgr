<FILE Name="/usr/local/emhttp/plugins/p410mgr/include/lib.php">
<INLINE><![CDATA[
<?php
require_once __DIR__ . '/i18n.php';
/* p410mgr — library: running hpssacli and parsing its output */

const P410_BIN   = '/usr/local/sbin/hpssacli';
const P410_CACHE = '/tmp/p410mgr_cciss.json';

function p410_run(string $args, ?int &$rc = null): string {
  $out = [];
  exec(P410_BIN . ' ' . $args . ' 2>&1', $out, $rc);
  return implode("\n", $out);
}

function p410_valid_slot($s): bool { return is_string($s) && preg_match('/^\d{1,2}$/', $s) === 1; }
function p410_valid_pd($s): bool   { return is_string($s) && preg_match('/^\d{1,2}[IEC]:\d{1,2}:\d{1,3}$/', $s) === 1; }
function p410_valid_ld($s): bool   { return is_string($s) && preg_match('/^\d{1,3}$/', $s) === 1; }

/* "Smart Array P410 in Slot 3 (sn: XXX)" -> [ ['slot'=>'3','model'=>'Smart Array P410'] ] */
function p410_parse_controllers(string $txt): array {
  $res = [];
  if (preg_match_all('/^\s*(.+?) in Slot (\d+)/m', $txt, $m, PREG_SET_ORDER)) {
    foreach ($m as $x) $res[] = ['slot' => $x[2], 'model' => trim($x[1])];
  }
  return $res;
}

/* Simple first-level "Key: Value" pairs (ctrl show detail) */
function p410_parse_kv(string $txt): array {
  $kv = [];
  foreach (explode("\n", $txt) as $line) {
    if (preg_match('/^\s*([^:]{2,60}?):\s+(.*\S)\s*$/', $line, $m)) {
      $k = trim($m[1]);
      if (!isset($kv[$k])) $kv[$k] = trim($m[2]);
    }
  }
  return $kv;
}

/* ctrl slot=X show config -> drives with array/LD assignment + unassigned */
function p410_parse_config(string $txt): array {
  $arrays = []; $pds = []; $lds = [];
  $curArray = null; $curLd = null; $unassigned = false;
  foreach (explode("\n", $txt) as $line) {
    $t = trim($line);
    if ($t === '') continue;
    if (preg_match('/^array (\S+)\s*\((.*)\)/', $t, $m)) {
      $curArray = $m[1]; $curLd = null; $unassigned = false;
      $arrays[$curArray] = ['name' => $curArray, 'info' => $m[2], 'lds' => []];
      continue;
    }
    if ($t === 'unassigned') { $unassigned = true; $curArray = null; $curLd = null; continue; }
    if (preg_match('/^logicaldrive (\d+)\s*\(([^,]+),\s*([^,]+),\s*([^)]+)\)/', $t, $m)) {
      $curLd = $m[1];
      $lds[$curLd] = ['ld' => $curLd, 'size' => trim($m[2]), 'raid' => trim($m[3]),
                      'status' => trim($m[4]), 'array' => $curArray, 'pds' => []];
      if ($curArray !== null) $arrays[$curArray]['lds'][] = $curLd;
      continue;
    }
    if (preg_match('/^physicaldrive (\S+)\s*\((.*)\)/', $t, $m)) {
      $pd = $m[1];
      $parts = array_map('trim', explode(',', $m[2]));
      $bay = null;
      if (preg_match('/bay (\d+)/', $m[2], $b)) $bay = (int)$b[1];
      $n = count($parts);
      $pds[$pd] = [
        'pd'         => $pd,
        'bay'        => $bay,
        'type'       => $n >= 3 ? $parts[$n - 3] : '',
        'size'       => $n >= 2 ? $parts[$n - 2] : '',
        'status'     => $n >= 1 ? $parts[$n - 1] : '',
        'array'      => $unassigned ? null : $curArray,
        'unassigned' => $unassigned,
        'lds'        => [],
      ];
      if (!$unassigned && $curArray !== null) {
        foreach ($arrays[$curArray]['lds'] as $l) { $lds[$l]['pds'][] = $pd; $pds[$pd]['lds'][] = $l; }
      }
      continue;
    }
  }
  return ['arrays' => $arrays, 'lds' => $lds, 'pds' => $pds];
}

/* Bloki "Logical Drive: N" z ld all show detail */
function p410_parse_ld_detail(string $txt): array {
  $res = []; $cur = null;
  foreach (explode("\n", $txt) as $line) {
    if (preg_match('/^\s*Logical Drive:\s*(\d+)/', $line, $m)) { $cur = $m[1]; $res[$cur] = []; continue; }
    if ($cur !== null && preg_match('/^\s*([^:]{2,60}?):\s+(.*\S)\s*$/', $line, $m)) {
      $k = trim($m[1]); if (!isset($res[$cur][$k])) $res[$cur][$k] = trim($m[2]);
    }
  }
  return $res;
}

/* Bloki "physicaldrive X" z pd all show detail */
function p410_parse_pd_detail(string $txt): array {
  $res = []; $cur = null;
  foreach (explode("\n", $txt) as $line) {
    if (preg_match('/^\s*physicaldrive (\S+)\s*$/', $line, $m)) { $cur = $m[1]; $res[$cur] = []; continue; }
    if ($cur !== null && preg_match('/^\s*([^:]{2,60}?):\s+(.*\S)\s*$/', $line, $m)) {
      $k = trim($m[1]); if (!isset($res[$cur][$k])) $res[$cur][$k] = trim($m[2]);
    }
  }
  return $res;
}

/* Unraid assignments: device (sdX) -> slot name (disk1, parity, cache...) */
function p410_unraid_assignments(): array {
  $map = [];
  $ini = '/var/local/emhttp/disks.ini';
  if (is_readable($ini)) {
    $disks = @parse_ini_file($ini, true) ?: [];
    foreach ($disks as $name => $d) {
      $dev = $d['device'] ?? '';
      if ($dev !== '' && ($d['type'] ?? '') !== 'Flash') $map[$dev] = $d['name'] ?? $name;
    }
  }
  return $map;
}

function p410_dev_in_use(string $dev): ?string {
  $dev = basename($dev);
  if ($dev === '' || !preg_match('/^sd[a-z]+$/', $dev)) return null;
  $assign = p410_unraid_assignments();
  if (isset($assign[$dev])) return p410_t('in_unraid', $assign[$dev]);
  $mounts = @file_get_contents('/proc/mounts') ?: '';
  if (preg_match('#^/dev/' . preg_quote($dev, '#') . '\d*\s#m', $mounts)) return p410_t('mounted');
  $holders = glob("/sys/block/$dev/holders/*") ?: [];
  if ($holders) return p410_t('used_by', implode(', ', array_map('basename', $holders)));
  return null;
}

/* Full state of all controllers */
function p410_status(): array {
  if (!is_executable(P410_BIN)) return ['error' => p410_t('no_bin', P410_BIN)];
  $ctrls = p410_parse_controllers(p410_run('ctrl all show'));
  if (!$ctrls) return ['error' => p410_t('no_ctrl')];
  $assign = p410_unraid_assignments();
  foreach ($ctrls as &$c) {
    $s = $c['slot'];
    $c['detail'] = p410_parse_kv(p410_run("ctrl slot=$s show detail"));
    $cfg  = p410_parse_config(p410_run("ctrl slot=$s show config"));
    $ldd  = p410_parse_ld_detail(p410_run("ctrl slot=$s ld all show detail"));
    $pdd  = p410_parse_pd_detail(p410_run("ctrl slot=$s pd all show detail"));
    foreach ($cfg['lds'] as $n => &$ld) {
      $d = $ldd[$n] ?? [];
      $dev = $d['Disk Name'] ?? '';
      $ld['dev']     = $dev;
      $ld['caching'] = $d['Caching'] ?? '';
      $ld['unraid']  = $dev !== '' ? ($assign[basename($dev)] ?? '') : '';
      $ld['present'] = $dev !== '' && file_exists($dev);
    }
    unset($ld);
    foreach ($cfg['pds'] as $p => &$pd) {
      $d = $pdd[$p] ?? [];
      $pd['model']  = preg_replace('/\s+/', ' ', $d['Model'] ?? '');
      $pd['serial'] = $d['Serial Number'] ?? '';
      $pd['temp']   = $d['Current Temperature (C)'] ?? '';
      $pd['fw']     = $d['Firmware Revision'] ?? '';
      $pd['rpm']    = $d['Rotational Speed'] ?? '';
      $pd['link']   = $d['PHY Transfer Rate'] ?? '';
      if (!empty($d['Status'])) $pd['status'] = $d['Status'];
    }
    unset($pd);
    $c['lds'] = array_values($cfg['lds']);
    $pds = array_values($cfg['pds']);
    usort($pds, fn($a, $b) => ($a['bay'] ?? 999) <=> ($b['bay'] ?? 999));
    $c['pds'] = $pds;
  }
  unset($c);
  return ['controllers' => $ctrls];
}

/* Find the cciss,N index for a serial number (cached in /tmp) */
function p410_cciss_index(string $slot, string $serial): ?array {
  $cache = @json_decode(@file_get_contents(P410_CACHE) ?: '[]', true) ?: [];
  $ldd = p410_parse_ld_detail(p410_run("ctrl slot=$slot ld all show detail"));
  $dev = null;
  foreach ($ldd as $d) { $n = $d['Disk Name'] ?? ''; if ($n !== '' && file_exists($n)) { $dev = $n; break; } }
  if ($dev === null) return null;
  if (isset($cache[$slot][$serial])) return ['dev' => $dev, 'n' => $cache[$slot][$serial]];
  for ($i = 0; $i < 32; $i++) {
    $o = [];
    exec('smartctl -i -d cciss,' . $i . ' ' . escapeshellarg($dev) . ' 2>/dev/null', $o);
    foreach ($o as $line) {
      if (preg_match('/^Serial number:\s*(\S+)/i', $line, $m)) {
        $cache[$slot][$m[1]] = $i;
      }
    }
  }
  @file_put_contents(P410_CACHE, json_encode($cache));
  return isset($cache[$slot][$serial]) ? ['dev' => $dev, 'n' => $cache[$slot][$serial]] : null;
}

function p410_rescan_hpsa(): void {
  foreach (glob('/sys/class/scsi_host/host*') ?: [] as $h) {
    if (trim(@file_get_contents("$h/proc_name") ?: '') === 'hpsa') @file_put_contents("$h/scan", "- - -");
  }
}
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/p410mgr/include/exec.php">
<INLINE><![CDATA[
<?php
/* p410mgr — AJAX backend (POST; CSRF token is checked by Unraid) */
require_once __DIR__ . '/monitor.php';
header('Content-Type: application/json; charset=utf-8');

function p410_out(array $a): void { echo json_encode($a, JSON_UNESCAPED_UNICODE); exit; }
function p410_fail(string $msg): void { p410_out(['ok' => false, 'msg' => $msg]); }

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') p410_fail(p410_t('only_post'));
if (!is_executable(P410_BIN)) p410_fail(p410_t('no_bin', P410_BIN));

$action = $_POST['action'] ?? '';
$slot   = $_POST['slot'] ?? '';
$noSlot = ['status', 'summary', 'getcfg', 'savecfg', 'testmqtt', 'runcheck', 'resetbaseline', 'laststate'];
if (!in_array($action, $noSlot, true) && !p410_valid_slot($slot)) p410_fail(p410_t('bad_slot'));

switch ($action) {

  case 'status':
    p410_out(['ok' => true] + p410_status());

  case 'summary':
    $st = p410_status();
    if (isset($st['error'])) p410_out(['ok' => false, 'msg' => $st['error']]);
    $mcfg = p410_cfg_load();
    $sum = [];
    foreach ($st['controllers'] as $c) {
      $d = $c['detail'];
      $bad = []; $temps = []; $unassigned = 0;
      foreach ($c['pds'] as $p) {
        if (strcasecmp($p['status'], 'OK') !== 0) $bad[] = p410_t('bay_state', $p['bay'], $p['status']);
        if ($p['unassigned']) $unassigned++;
        if (is_numeric($p['temp'])) $temps[] = (int)$p['temp'];
      }
      foreach ($c['lds'] as $l) if (strcasecmp($l['status'], 'OK') !== 0) $bad[] = "LD {$l['ld']}: {$l['status']}";
      $sum[] = [
        'slot' => $c['slot'], 'model' => $c['model'],
        'ctrl' => $d['Controller Status'] ?? '?', 'cache' => $d['Cache Status'] ?? '?',
        'battery' => $d['Battery/Capacitor Status'] ?? '—', 'fw' => $d['Firmware Version'] ?? '',
        'pds' => count($c['pds']), 'lds' => count($c['lds']), 'unassigned' => $unassigned,
        'ign_cache' => $mcfg['IGNORE_CACHE'] === 'yes', 'ign_battery' => $mcfg['IGNORE_BATTERY'] === 'yes',
        'tmax' => $temps ? max($temps) : null, 'bad' => $bad,
      ];
    }
    p410_out(['ok' => true, 'controllers' => $sum]);

  case 'led':
    $pd = $_POST['pd'] ?? ''; $state = $_POST['state'] ?? '';
    if (!p410_valid_pd($pd) || !in_array($state, ['on', 'off'], true)) p410_fail(p410_t('bad_params'));
    $o = p410_run("ctrl slot=$slot pd $pd modify led=$state", $rc);
    p410_out(['ok' => $rc === 0, 'msg' => $rc === 0 ? p410_t('led_done', $pd, $state) : $o]);

  case 'smart':
    $pd = $_POST['pd'] ?? '';
    if (!p410_valid_pd($pd)) p410_fail(p410_t('bad_drive'));
    $pdd = p410_parse_pd_detail(p410_run("ctrl slot=$slot pd $pd show detail"));
    $serial = $pdd[$pd]['Serial Number'] ?? '';
    if ($serial === '') p410_fail(p410_t('no_serial'));
    $idx = p410_cciss_index($slot, $serial);
    if ($idx === null) p410_fail(p410_t('no_cciss'));
    $o = [];
    exec('smartctl -a -d cciss,' . (int)$idx['n'] . ' ' . escapeshellarg($idx['dev']) . ' 2>&1', $o);
    p410_out(['ok' => true, 'msg' => "cciss,{$idx['n']} @ {$idx['dev']}", 'text' => implode("\n", $o)]);

  case 'create':
    $pd = $_POST['pd'] ?? '';
    if (!p410_valid_pd($pd)) p410_fail(p410_t('bad_drive'));
    $cfg = p410_parse_config(p410_run("ctrl slot=$slot show config"));
    if (empty($cfg['pds'][$pd]['unassigned'])) p410_fail(p410_t('not_unassigned', $pd));
    $before = array_keys($cfg['lds']);
    $o = p410_run("ctrl slot=$slot create type=ld drives=$pd raid=0", $rc);
    if ($rc !== 0) p410_fail(p410_t('create_err', $o));
    sleep(2);
    $ldd = p410_parse_ld_detail(p410_run("ctrl slot=$slot ld all show detail"));
    $new = array_values(array_diff(array_keys($ldd), $before));
    $ld  = $new[0] ?? null;
    $dev = $ld !== null ? ($ldd[$ld]['Disk Name'] ?? '') : '';
    if ($dev === '' || !file_exists($dev)) {
      p410_rescan_hpsa(); sleep(2);
      $ldd = p410_parse_ld_detail(p410_run("ctrl slot=$slot ld all show detail"));
      $dev = $ld !== null ? ($ldd[$ld]['Disk Name'] ?? '') : '';
    }
    p410_out(['ok' => true, 'msg' => p410_t('created', $ld, $pd) . ($dev ? " → $dev" : p410_t('created_nodev'))]);

  case 'delete':
    $ld = $_POST['ld'] ?? ''; $confirm = $_POST['confirm'] ?? '';
    if (!p410_valid_ld($ld)) p410_fail(p410_t('bad_ld'));
    if ($confirm !== $ld) p410_fail(p410_t('confirm_bad'));
    $ldd = p410_parse_ld_detail(p410_run("ctrl slot=$slot ld all show detail"));
    if (!isset($ldd[$ld])) p410_fail(p410_t('ld_missing', $ld));
    $dev = $ldd[$ld]['Disk Name'] ?? '';
    if ($dev !== '') {
      $use = p410_dev_in_use($dev);
      if ($use !== null) p410_fail(p410_t('refused', $dev, $use));
    }
    $o = p410_run("ctrl slot=$slot ld $ld delete forced", $rc);
    if ($rc !== 0) p410_fail(p410_t('delete_err', $o));
    @unlink(P410_CACHE);
    p410_out(['ok' => true, 'msg' => p410_t('deleted', $ld) . ($dev ? " ($dev)" : '')]);

  case 'cache':
    $ld = $_POST['ld'] ?? ''; $state = $_POST['state'] ?? '';
    if (!p410_valid_ld($ld) || !in_array($state, ['enable', 'disable'], true)) p410_fail(p410_t('bad_params'));
    $o = p410_run("ctrl slot=$slot ld $ld modify arrayaccelerator=$state", $rc);
    p410_out(['ok' => $rc === 0, 'msg' => $rc === 0 ? p410_t('cache_done', $ld, $state) : $o]);


  case 'getcfg':
    $cfg = p410_cfg_load(); $cfg['MQTT_PASS'] = $cfg['MQTT_PASS'] !== '' ? '********' : '';
    p410_out(['ok' => true, 'cfg' => $cfg]);

  case 'savecfg':
    $in = $_POST['cfg'] ?? [];
    if (!is_array($in)) p410_fail(p410_t('no_data'));
    if (($in['MQTT_PASS'] ?? '') === '********') unset($in['MQTT_PASS']);
    p410_cfg_save($in);
    p410_out(['ok' => true, 'msg' => p410_t('saved')]);

  case 'testmqtt':
    $cfg = p410_cfg_load();
    if ($cfg['MQTT_HOST'] === '') p410_fail(p410_t('set_broker'));
    $err = null;
    $ok = p410_mqtt_publish($cfg, [[$cfg['MQTT_TOPIC'] . '/test', 'p410mgr test ' . date('c'), false]], $err);
    p410_out(['ok' => $ok, 'msg' => $ok ? p410_t('mqtt_test_ok', $cfg['MQTT_HOST'], $cfg['MQTT_TOPIC']) : $err]);

  case 'runcheck':
    $r = p410_run_check(true);
    p410_out(['ok' => true, 'state' => $r]);

  case 'laststate':
    $r = @json_decode(@file_get_contents(P410_STATE) ?: 'null', true);
    p410_out(['ok' => true, 'state' => $r]);

  case 'resetbaseline':
    p410_baseline_reset();
    p410_out(['ok' => true, 'msg' => p410_t('baseline_reset')]);

  default:
    p410_fail(p410_t('unknown_action'));
}
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/p410mgr/include/monitor.php">
<INLINE><![CDATA[
<?php
/* p410mgr — monitoring: config, SMART, problem detection, MQTT, HA discovery */
require_once __DIR__ . '/lib.php';

const P410_CFG_DIR  = '/boot/config/plugins/p410mgr';
const P410_CFG      = P410_CFG_DIR . '/p410mgr.cfg';
const P410_CRON     = P410_CFG_DIR . '/p410mgr.cron';
const P410_BASELINE = P410_CFG_DIR . '/smart_baseline.json';
const P410_STATE    = '/tmp/p410mgr_state.json';

function p410_cfg_defaults(): array {
  return [
    'MON_ENABLED' => 'no', 'INTERVAL' => '60', 'TEMP_WARN' => '45', 'LANG' => 'auto', 'SKIP_STANDBY' => 'yes', 'IGNORE_CACHE' => 'no', 'IGNORE_BATTERY' => 'no',
    'NOTIFY' => 'yes',
    'MQTT_ENABLED' => 'no', 'MQTT_HOST' => '', 'MQTT_PORT' => '1883', 'MQTT_USER' => '', 'MQTT_PASS' => '',
    'MQTT_TOPIC' => 'unraid/p410', 'MQTT_DISCOVERY' => 'yes', 'MQTT_DISCOVERY_PREFIX' => 'homeassistant',
  ];
}

function p410_cfg_load(): array {
  $cfg = p410_cfg_defaults();
  if (is_readable(P410_CFG)) {
    $ini = @parse_ini_file(P410_CFG, false, INI_SCANNER_RAW) ?: [];
    foreach ($ini as $k => $v) if (array_key_exists($k, $cfg)) $cfg[$k] = $v;
  }
  return $cfg;
}

function p410_cfg_save(array $in): array {
  $cfg = p410_cfg_load();
  foreach (p410_cfg_defaults() as $k => $_) if (isset($in[$k])) $cfg[$k] = str_replace(["\n", "\r", '"'], '', trim((string)$in[$k]));
  $cfg['INTERVAL']  = (string)max(5, min(1440, (int)$cfg['INTERVAL']));
  $cfg['TEMP_WARN'] = (string)max(30, min(70, (int)$cfg['TEMP_WARN']));
  if (!in_array($cfg['LANG'], ['auto', 'en', 'pl'], true)) $cfg['LANG'] = 'auto';
  $cfg['MQTT_PORT'] = (string)max(1, min(65535, (int)$cfg['MQTT_PORT']));
  $cfg['MQTT_TOPIC'] = trim(preg_replace('#[^A-Za-z0-9_/\-]#', '', $cfg['MQTT_TOPIC']), '/') ?: 'unraid/p410';
  $cfg['MQTT_DISCOVERY_PREFIX'] = trim(preg_replace('#[^A-Za-z0-9_/\-]#', '', $cfg['MQTT_DISCOVERY_PREFIX']), '/') ?: 'homeassistant';
  @mkdir(P410_CFG_DIR, 0755, true);
  $txt = '';
  foreach ($cfg as $k => $v) $txt .= $k . '="' . $v . "\"\n";
  file_put_contents(P410_CFG, $txt);
  p410_cron_update($cfg);
  return $cfg;
}

function p410_cron_update(array $cfg): void {
  if ($cfg['MON_ENABLED'] === 'yes') {
    $m = (int)$cfg['INTERVAL'];
    $sched = $m < 60 ? "*/$m * * * *" : ($m % 60 === 0 && $m < 1440 ? '7 */' . ($m / 60) . ' * * *' : '7 3 * * *');
    file_put_contents(P410_CRON, "# Generated by p410mgr\n$sched /usr/bin/php /usr/local/emhttp/plugins/p410mgr/scripts/check.php >/dev/null 2>&1\n");
  } else {
    @unlink(P410_CRON);
  }
  if (is_executable('/usr/local/sbin/update_cron')) exec('/usr/local/sbin/update_cron');
}

/* ---------- SMART ---------- */

function p410_cciss_map(string $slot, string $dev): array {
  $map = [];
  for ($i = 0; $i < 32; $i++) {
    $o = [];
    exec('smartctl -i -d cciss,' . $i . ' ' . escapeshellarg($dev) . ' 2>/dev/null', $o);
    foreach ($o as $line) if (preg_match('/^Serial number:\s*(\S+)/i', $line, $m)) $map[$m[1]] = $i;
  }
  @file_put_contents(P410_CACHE, json_encode([$slot => $map]));
  return $map;
}

function p410_parse_smart(string $txt): array {
  $r = ['health' => null, 'temp' => null, 'defects' => null, 'uncorrected' => null,
        'realloc' => null, 'pending' => null, 'offline_unc' => null, 'hours' => null];
  if (preg_match('/SMART Health Status:\s*(.+)/', $txt, $m)) $r['health'] = trim($m[1]);
  if (preg_match('/overall-health self-assessment test result:\s*(\S+)/', $txt, $m)) $r['health'] = trim($m[1]);
  if (preg_match('/Current Drive Temperature:\s*(\d+)/', $txt, $m)) $r['temp'] = (int)$m[1];
  if (preg_match('/Elements in grown defect list:\s*(\d+)/', $txt, $m)) $r['defects'] = (int)$m[1];
  if (preg_match('/Accumulated power on time, hours:minutes\s*(\d+)/', $txt, $m)) $r['hours'] = (int)$m[1];
  if (preg_match_all('/^(read|write|verify):\s+(?:\S+\s+){5}\S+\s+(\d+)\s*$/m', $txt, $mm)) $r['uncorrected'] = array_sum(array_map('intval', $mm[2]));
  /* ATA */
  $attr = function (string $name) use ($txt) {
    return preg_match('/^\s*\d+\s+' . $name . '\s+.*\s(\d+)(?:\s+\(.*\))?\s*$/m', $txt, $m) ? (int)$m[1] : null;
  };
  $r['realloc']     = $attr('Reallocated_Sector_Ct');
  $r['pending']     = $attr('Current_Pending_Sector');
  $r['offline_unc'] = $attr('Offline_Uncorrectable');
  if ($r['temp'] === null) $r['temp'] = $attr('Temperature_Celsius');
  if ($r['hours'] === null) $r['hours'] = $attr('Power_On_Hours');
  return $r;
}

/* ---------- Full check ---------- */

function p410_check(array $cfg, bool $forceSmart = false): array {
  $st = p410_status();
  $res = ['ts' => date('c'), 'problem' => false, 'problems' => [], 'controllers' => [], 'drives' => []];
  if (isset($st['error'])) { $res['problem'] = true; $res['problems'][] = $st['error']; return $res; }
  $baseline = @json_decode(@file_get_contents(P410_BASELINE) ?: '{}', true) ?: [];
  $prev = @json_decode(@file_get_contents(P410_STATE) ?: '{}', true) ?: [];
  $prevDrives = [];
  foreach ($prev['drives'] ?? [] as $d) $prevDrives[$d['serial'] ?? ''] = $d;
  $baselineChanged = false;
  $tw = (int)$cfg['TEMP_WARN'];

  foreach ($st['controllers'] as $c) {
    $d = $c['detail']; $slot = $c['slot'];
    $ctrl = ['slot' => $slot, 'model' => $c['model'], 'status' => $d['Controller Status'] ?? '?',
             'cache' => $d['Cache Status'] ?? '?', 'battery' => $d['Battery/Capacitor Status'] ?? '—',
             'fw' => $d['Firmware Version'] ?? ''];
    $res['controllers'][] = $ctrl;
    if (strcasecmp($ctrl['status'], 'OK')) $res['problems'][] = p410_t('pr_ctrl', $slot, $ctrl['status']);
    $ctrl['cache_ignored'] = $cfg['IGNORE_CACHE'] === 'yes'; $ctrl['battery_ignored'] = $cfg['IGNORE_BATTERY'] === 'yes';
    if (!$ctrl['cache_ignored'] && strcasecmp($ctrl['cache'], 'OK')) $res['problems'][] = p410_t('pr_cache', $ctrl['cache']);
    if (!$ctrl['battery_ignored'] && $ctrl['battery'] !== '—' && strcasecmp($ctrl['battery'], 'OK')) $res['problems'][] = p410_t('pr_batt', $ctrl['battery']);

    $ldMap = []; $dev = null;
    foreach ($c['lds'] as $l) {
      $ldMap[$l['ld']] = $l;
      if (!$dev && $l['present']) $dev = $l['dev'];
      if (strcasecmp($l['status'], 'OK')) $res['problems'][] = p410_t('pr_ld', $l['ld'], $l['dev'], $l['status']);
    }
    $cmap = [];
    if ($dev) {
      $cached = @json_decode(@file_get_contents(P410_CACHE) ?: '[]', true)[$slot] ?? [];
      $need = array_filter(array_column($c['pds'], 'serial'));
      $cmap = ($cached && !array_diff($need, array_keys($cached))) ? $cached : p410_cciss_map($slot, $dev);
    }

    foreach ($c['pds'] as $p) {
      $ld = $p['lds'] ? ($ldMap[$p['lds'][0]] ?? null) : null;
      $drv = ['bay' => $p['bay'], 'pd' => $p['pd'], 'model' => $p['model'], 'serial' => $p['serial'],
              'size' => $p['size'], 'status' => $p['status'], 'ld' => $ld['ld'] ?? null, 'dev' => $ld['dev'] ?? null,
              'unraid' => $ld['unraid'] ?? ($p['unassigned'] ? 'unassigned' : ''),
              'temp' => is_numeric($p['temp']) ? (int)$p['temp'] : null, 'smart' => null, 'problems' => []];
      $label = p410_t('pr_label', $p['bay'], $p['serial'] . ($drv['unraid'] ? ", {$drv['unraid']}" : ''));
      if (strcasecmp($p['status'], 'OK')) $drv['problems'][] = p410_t('pr_state', $p['status']);

      $n = $cmap[$p['serial']] ?? null;
      if ($n !== null && $dev) {
        $o = []; $rc = 0;
        $standby = $cfg['SKIP_STANDBY'] === 'yes' && !$forceSmart ? ' -n standby' : '';
        exec('smartctl -a' . $standby . ' -d cciss,' . (int)$n . ' ' . escapeshellarg($dev) . ' 2>&1', $o, $rc);
        if (($rc & 0x02) && $standby && preg_match('/STANDBY|SLEEP/i', implode("\n", $o))) {
          $drv['smart'] = $prevDrives[$p['serial']]['smart'] ?? null;
          $drv['standby'] = true;
        } else {
          $drv['smart'] = p410_parse_smart(implode("\n", $o));
        }
      }
      $s = $drv['smart'];
      if ($s) {
        if ($drv['temp'] === null && $s['temp'] !== null) $drv['temp'] = $s['temp'];
        if ($s['health'] !== null && !preg_match('/^(OK|PASSED)$/i', $s['health'])) $drv['problems'][] = "SMART: {$s['health']}";
        if (($s['pending'] ?? 0) > 0) $drv['problems'][] = p410_t('pr_pending', $s['pending']);
        if (($s['offline_unc'] ?? 0) > 0) $drv['problems'][] = p410_t('pr_offline', $s['offline_unc']);
        $b = $baseline[$p['serial']] ?? null;
        if ($b === null) {
          $baseline[$p['serial']] = ['defects' => $s['defects'], 'realloc' => $s['realloc'], 'uncorrected' => $s['uncorrected']];
          $baselineChanged = true;
        } else {
          foreach (['defects' => p410_t('c_defects'), 'realloc' => p410_t('c_realloc'), 'uncorrected' => p410_t('c_uncorr')] as $k => $name) {
            if ($s[$k] !== null && $b[$k] !== null && $s[$k] > $b[$k]) $drv['problems'][] = p410_t('pr_increase', $name, $b[$k], $s[$k]);
          }
        }
      }
      if ($drv['temp'] !== null && $drv['temp'] >= $tw) $drv['problems'][] = p410_t('pr_temp', $drv['temp'], $tw);
      foreach ($drv['problems'] as $pr) $res['problems'][] = "$label: $pr";
      $res['drives'][] = $drv;
    }
  }
  if ($baselineChanged) { @mkdir(P410_CFG_DIR, 0755, true); @file_put_contents(P410_BASELINE, json_encode($baseline)); }
  $res['problem'] = (bool)$res['problems'];
  return $res;
}

function p410_baseline_reset(): void { @unlink(P410_BASELINE); }

/* ---------- MQTT 3.1.1 (QoS 0) ---------- */

function p410_mqtt_str(string $s): string { return pack('n', strlen($s)) . $s; }
function p410_mqtt_len(int $n): string {
  $o = '';
  do { $b = $n % 128; $n = intdiv($n, 128); if ($n > 0) $b |= 0x80; $o .= chr($b); } while ($n > 0);
  return $o;
}

/* $msgs = [[topic, payload, retain], ...] */
function p410_mqtt_publish(array $cfg, array $msgs, ?string &$err = null): bool {
  $sock = @stream_socket_client('tcp://' . $cfg['MQTT_HOST'] . ':' . (int)$cfg['MQTT_PORT'], $eno, $estr, 5);
  if (!$sock) { $err = p410_t('mqtt_conn_fail', $cfg['MQTT_HOST'], $cfg['MQTT_PORT'], $estr); return false; }
  stream_set_timeout($sock, 5);
  $flags = 0x02; $payload = p410_mqtt_str('p410mgr-' . substr(md5(gethostname() . getmypid()), 0, 8));
  if ($cfg['MQTT_USER'] !== '') { $flags |= 0x80; }
  if ($cfg['MQTT_USER'] !== '' && $cfg['MQTT_PASS'] !== '') { $flags |= 0x40; }
  if ($flags & 0x80) $payload .= p410_mqtt_str($cfg['MQTT_USER']);
  if ($flags & 0x40) $payload .= p410_mqtt_str($cfg['MQTT_PASS']);
  $vh = p410_mqtt_str('MQTT') . chr(4) . chr($flags) . pack('n', 30);
  fwrite($sock, chr(0x10) . p410_mqtt_len(strlen($vh . $payload)) . $vh . $payload);
  $ack = fread($sock, 4);
  if (strlen($ack) < 4 || ord($ack[0]) !== 0x20 || ord($ack[3]) !== 0) {
    $codes = [1 => p410_t('mqtt_rc1'), 2 => p410_t('mqtt_rc2'), 3 => p410_t('mqtt_rc3'), 4 => p410_t('mqtt_rc4'), 5 => p410_t('mqtt_rc5')];
    $err = p410_t('mqtt_rejected') . (strlen($ack) >= 4 ? ': ' . ($codes[ord($ack[3])] ?? p410_t('mqtt_rcx', ord($ack[3]))) : p410_t('mqtt_noack'));
    fclose($sock); return false;
  }
  foreach ($msgs as [$topic, $data, $retain]) {
    $body = p410_mqtt_str($topic) . $data;
    fwrite($sock, chr(0x30 | ($retain ? 1 : 0)) . p410_mqtt_len(strlen($body)) . $body);
  }
  fwrite($sock, chr(0xE0) . chr(0));
  fclose($sock);
  return true;
}

/* ---------- MQTT messages + Home Assistant discovery ---------- */

function p410_mqtt_messages(array $cfg, array $res, array $newProblems): array {
  $t = $cfg['MQTT_TOPIC'];
  $j = fn($a) => json_encode($a, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
  $ctrl = $res['controllers'][0] ?? [];
  $temps = array_filter(array_column($res['drives'], 'temp'), fn($x) => $x !== null);
  $state = ['problem' => $res['problem'], 'problems' => $res['problems'], 'problem_count' => count($res['problems']),
            'controller' => $ctrl['status'] ?? null, 'cache' => $ctrl['cache'] ?? null, 'battery' => $ctrl['battery'] ?? null,
            'max_temp' => $temps ? max($temps) : null, 'drives' => count($res['drives']), 'ts' => $res['ts']];
  $msgs = [["$t/state", $j($state), true], ["$t/problem", $res['problem'] ? 'ON' : 'OFF', true]];
  foreach ($res['drives'] as $d) {
    $msgs[] = ["$t/bay/{$d['bay']}", $j([
      'status' => $d['problems'] ? 'PROBLEM' : 'OK', 'problems' => $d['problems'], 'temp' => $d['temp'],
      'model' => $d['model'], 'serial' => $d['serial'], 'unraid' => $d['unraid'], 'dev' => $d['dev'], 'ld' => $d['ld'],
      'hours' => $d['smart']['hours'] ?? null, 'defects' => $d['smart']['defects'] ?? null,
      'realloc' => $d['smart']['realloc'] ?? null, 'pending' => $d['smart']['pending'] ?? null,
      'uncorrected' => $d['smart']['uncorrected'] ?? null, 'health' => $d['smart']['health'] ?? null,
    ]), true];
  }
  if ($newProblems) $msgs[] = ["$t/alert", $j(['ts' => $res['ts'], 'new' => $newProblems, 'all' => $res['problems']]), false];

  if ($cfg['MQTT_DISCOVERY'] === 'yes') {
    $p = $cfg['MQTT_DISCOVERY_PREFIX'];
    $dev = ['identifiers' => ['p410mgr_' . gethostname()], 'name' => 'Smart Array P410 (' . gethostname() . ')',
            'manufacturer' => 'HP', 'model' => $ctrl['model'] ?? 'Smart Array', 'sw_version' => $ctrl['fw'] ?? ''];
    $uid = 'p410mgr_' . preg_replace('/\W/', '_', gethostname());
    $msgs[] = ["$p/binary_sensor/$uid/problem/config", $j(['name' => p410_t('ha_problem'), 'unique_id' => "{$uid}_problem",
      'device_class' => 'problem', 'state_topic' => "$t/state", 'value_template' => "{{ 'ON' if value_json.problem else 'OFF' }}",
      'json_attributes_topic' => "$t/state", 'json_attributes_template' => '{{ {"problems": value_json.problems} | tojson }}',
      'device' => $dev]), true];
    foreach (['controller' => [p410_t('ha_controller'), 'mdi:expansion-card'], 'cache' => [p410_t('ha_cache'), 'mdi:memory'], 'battery' => [p410_t('ha_battery'), 'mdi:battery']] as $k => [$name, $icon]) {
      $msgs[] = ["$p/sensor/$uid/$k/config", $j(['name' => $name, 'unique_id' => "{$uid}_$k", 'icon' => $icon,
        'state_topic' => "$t/state", 'value_template' => "{{ value_json.$k }}", 'device' => $dev]), true];
    }
    $msgs[] = ["$p/sensor/$uid/max_temp/config", $j(['name' => p410_t('ha_maxtemp'), 'unique_id' => "{$uid}_max_temp",
      'device_class' => 'temperature', 'unit_of_measurement' => '°C', 'state_class' => 'measurement',
      'state_topic' => "$t/state", 'value_template' => '{{ value_json.max_temp }}', 'device' => $dev]), true];
    foreach ($res['drives'] as $d) {
      $b = (int)$d['bay'];
      $msgs[] = ["$p/sensor/$uid/bay{$b}_temp/config", $j(['name' => p410_t('ha_bay_temp', $b), 'unique_id' => "{$uid}_bay{$b}_temp",
        'device_class' => 'temperature', 'unit_of_measurement' => '°C', 'state_class' => 'measurement',
        'state_topic' => "$t/bay/$b", 'value_template' => '{{ value_json.temp }}', 'device' => $dev]), true];
      $msgs[] = ["$p/sensor/$uid/bay{$b}_status/config", $j(['name' => p410_t('ha_bay_status', $b), 'unique_id' => "{$uid}_bay{$b}_status",
        'icon' => 'mdi:harddisk', 'state_topic' => "$t/bay/$b", 'value_template' => '{{ value_json.status }}',
        'json_attributes_topic' => "$t/bay/$b", 'device' => $dev]), true];
    }
  }
  return $msgs;
}

/* Full cycle: check, compare with previous run, notify, MQTT */
function p410_run_check(bool $forceSmart = false): array {
  $cfg = p410_cfg_load();
  $prev = @json_decode(@file_get_contents(P410_STATE) ?: '{}', true) ?: [];
  $res = p410_check($cfg, $forceSmart);
  $newProblems = array_values(array_diff($res['problems'], $prev['problems'] ?? []));
  $resolved = array_values(array_diff($prev['problems'] ?? [], $res['problems']));
  $res['new'] = $newProblems; $res['resolved'] = $resolved;

  if ($cfg['NOTIFY'] === 'yes' && is_executable('/usr/local/emhttp/webGui/scripts/notify')) {
    if ($newProblems) exec('/usr/local/emhttp/webGui/scripts/notify -e "Smart Array P410" -s ' . escapeshellarg(p410_t('ntf_problem', count($newProblems)))
      . ' -d ' . escapeshellarg(implode('; ', $newProblems)) . ' -i alert');
    if ($resolved && !$res['problem']) exec('/usr/local/emhttp/webGui/scripts/notify -e "Smart Array P410" -s ' . escapeshellarg(p410_t('ntf_resolved')) . ' -d '
      . escapeshellarg(implode('; ', $resolved)) . ' -i normal');
  }
  $res['mqtt'] = null;
  if ($cfg['MQTT_ENABLED'] === 'yes' && $cfg['MQTT_HOST'] !== '') {
    $err = null;
    $res['mqtt'] = p410_mqtt_publish($cfg, p410_mqtt_messages($cfg, $res, $newProblems), $err) ? 'OK' : $err;
  }
  @file_put_contents(P410_STATE, json_encode($res, JSON_UNESCAPED_UNICODE));
  return $res;
}
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/p410mgr/scripts/check.php">
<INLINE><![CDATA[
<?php
/* p410mgr — cykliczne sprawdzenie (cron) */
require_once '/usr/local/emhttp/plugins/p410mgr/include/monitor.php';
$lock = fopen('/tmp/p410mgr_check.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) exit(0);
$force = in_array('--force', $argv, true);
$r = p410_run_check($force);
echo ($r['problem'] ? 'PROBLEM: ' . implode('; ', $r['problems']) : 'OK') . "\n";
if ($r['mqtt'] !== null) echo "MQTT: {$r['mqtt']}\n";
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/p410mgr/scripts/extract_deb.php">
<INLINE><![CDATA[
<?php
/* Extracts a .deb package without 'ar' (not available on Unraid).
   Usage: php extract_deb.php file.deb destdir */
if ($argc < 3) { fwrite(STDERR, "usage: extract_deb.php file.deb destdir\n"); exit(2); }
[$_, $deb, $dest] = $argv;
$f = @fopen($deb, 'rb');
if (!$f || fread($f, 8) !== "!<arch>\n") { fwrite(STDERR, "Not a .deb (ar) archive: $deb\n"); exit(1); }
@mkdir($dest, 0755, true);
$found = false;
while (!feof($f)) {
  $hdr = fread($f, 60);
  if ($hdr === false || strlen($hdr) < 60) break;
  $name = rtrim(substr($hdr, 0, 16), " /");
  $size = (int)trim(substr($hdr, 48, 10));
  if (str_starts_with($name, 'data.tar')) {
    $tmp = rtrim($dest, '/') . '/' . $name;
    $o = fopen($tmp, 'wb');
    $left = $size;
    while ($left > 0) { $chunk = fread($f, min(1 << 20, $left)); if ($chunk === '' || $chunk === false) break; fwrite($o, $chunk); $left -= strlen($chunk); }
    fclose($o);
    $flag = str_ends_with($name, '.xz') ? 'J' : (str_ends_with($name, '.gz') ? 'z' : (str_ends_with($name, '.zst') ? '' : ''));
    $cmd = str_ends_with($name, '.zst')
      ? 'zstd -dc ' . escapeshellarg($tmp) . ' | tar -x --no-same-owner -C ' . escapeshellarg($dest)
      : 'tar -x' . $flag . 'f ' . escapeshellarg($tmp) . ' --no-same-owner -C ' . escapeshellarg($dest);
    passthru($cmd, $rc);
    unlink($tmp);
    if ($rc !== 0) { fwrite(STDERR, "tar failed ($rc)\n"); exit(1); }
    $found = true;
    break;
  }
  fseek($f, $size + ($size % 2), SEEK_CUR);
}
fclose($f);
if (!$found) { fwrite(STDERR, "data.tar.* not found in $deb\n"); exit(1); }
echo "OK\n";
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/p410mgr/scripts/install.sh" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
# p410mgr — installs hpssacli (runs on plugin install and on every boot)
PLG=/boot/config/plugins/p410mgr
EMH=/usr/local/emhttp/plugins/p410mgr
# The plugin manager downloads $DEB to $PLG and checks its SHA256 (see the
# <FILE> before this script in p410mgr.plg). Keep this name in step with build.py.
DEB=hpssacli-2.40-13.0_amd64.deb

if [ ! -s "$PLG/$DEB" ]; then
  echo "ERROR: $PLG/$DEB is missing. Reinstall the plugin so the plugin manager downloads and verifies it."
  exit 1
fi

rm -rf /tmp/p410mgr_x
if ! php "$EMH/scripts/extract_deb.php" "$PLG/$DEB" /tmp/p410mgr_x; then
  echo "Failed to extract $DEB – removing it, please reinstall the plugin."
  rm -f "$PLG/$DEB"; rm -rf /tmp/p410mgr_x; exit 1
fi
mkdir -p /opt/hp && rm -rf /opt/hp/hpssacli
cp -a /tmp/p410mgr_x/opt/hp/hpssacli /opt/hp/
rm -rf /tmp/p410mgr_x

chmod -R u+x /opt/hp/hpssacli
BIN=$(find /opt/hp/hpssacli -type f -name hpssacli | head -1)
if [ -z "$BIN" ]; then echo "ERROR: hpssacli binary not found after extraction."; exit 1; fi
ln -sf "$BIN" /usr/local/sbin/hpssacli
echo "hpssacli: $BIN"
/usr/local/sbin/hpssacli ctrl all show 2>&1 | grep -i "slot" || echo "Warning: hpssacli did not detect a controller."
[ -x /usr/local/sbin/update_cron ] && /usr/local/sbin/update_cron
echo "Smart Array P410 plugin installed – Settings → User Utilities → Smart Array P410 (+ Dashboard tile)"
]]></INLINE>
</FILE>
<FILE Name="&plugin;/hpssacli-2.40-13.0_amd64.deb">
<URL>https://downloads.linux.hpe.com/SDR/repo/mcp/pool/non-free/hpssacli-2.40-13.0_amd64.deb</URL>
<SHA256>5c131a25f9373c6382c25a04627ac735ca571b975712e53de0aed29126778787</SHA256>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
bash /usr/local/emhttp/plugins/p410mgr/scripts/install.sh
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
rm -f /usr/local/sbin/hpssacli /tmp/p410mgr_cciss.json /tmp/p410mgr_state.json /boot/config/plugins/p410mgr/p410mgr.cron
/usr/local/sbin/update_cron 2>/dev/null
rm -rf /opt/hp/hpssacli /usr/local/emhttp/plugins/p410mgr
# settings (p410mgr.cfg), SMART baseline and the hpssacli package stay on the flash drive
# full removal: rm -rf /boot/config/plugins/p410mgr
echo "Smart Array P410 plugin removed."
]]></INLINE>
</FILE>
</PLUGIN>
