<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "p410mgr">
<!ENTITY author "francuz152">
<!ENTITY version "2026.11.07f">
<!ENTITY github "francuz152/unraid-p410mgr">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/&name;.plg">
<!ENTITY plugin "/boot/config/plugins/&name;">
<!ENTITY emhttp "/usr/local/emhttp/plugins/&name;">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" support="https://github.com/&github;/issues" min="6.9.0" icon="hdd-o">

<CHANGES>
###2026.11.07f
- English UI (default) with Polish translation; language: auto / English / Polski
- Uninstall keeps settings, SMART baseline and the hpssacli package
- Options to ignore disabled controller cache / failed cache battery
- Periodic SMART + controller checks, Unraid notifications
- MQTT publishing with Home Assistant discovery
- Dashboard tile
- Status view, SMART, locate LED, create RAID0, delete LD, LD cache
</CHANGES>

<FILE Name="&emhttp;/README.md">
<INLINE><![CDATA[
**Smart Array P410**

Manage HP Smart Array controllers (P410 / P410i / P212 / P812 and related G6/G7 models) from the Unraid GUI:
controller and drive status, bay → logical drive → /dev → Unraid slot mapping, SMART via cciss,
locate LED, create RAID0 from a new drive, delete logical drives (blocked while in use), periodic
SMART checks with Unraid notifications and MQTT / Home Assistant discovery, and a Dashboard tile.
Uses HPE hpssacli 2.40, downloaded from the official HPE repository (HPE license applies).
Settings → User Utilities → Smart Array P410.
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/p410mgr/P410mgr.page">
<INLINE><![CDATA[
Menu="Utilities"
Title="Smart Array P410"
Icon="hdd-o"
---
<?php
require_once '/usr/local/emhttp/plugins/p410mgr/include/i18n.php';
if (!function_exists('p410_h')) { function p410_h(string $k, ...$a): string { return htmlspecialchars(p410_t($k, ...$a), ENT_QUOTES); } }
if (!function_exists('p410_yn')) { function p410_yn(string $name, bool $yesFirst = true): string {
  $y = '<option value="yes">' . p410_h('f_yes') . '</option>'; $n = '<option value="no">' . p410_h('f_no') . '</option>';
  return "<select name=\"$name\">" . ($yesFirst ? $y . $n : $n . $y) . '</select>';
} }
if (!function_exists('p410_onoff')) { function p410_onoff(string $name): string {
  return "<select name=\"$name\"><option value=\"no\">" . p410_h('f_off') . '</option><option value="yes">' . p410_h('f_on') . '</option></select>';
} }
?>
<style>
#p410 { --p410-line: rgba(127,127,127,.25); --p410-muted: rgba(127,127,127,.95); }
#p410 .p410-card { border: 1px solid var(--p410-line); border-radius: 6px; padding: 12px 16px; margin: 12px 0; }
#p410 .p410-head { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; }
#p410 .p410-head h3 { margin: 0 12px 0 0; font-size: 1.15em; }
#p410 .p410-kv span { color: var(--p410-muted); margin-right: 4px; }
#p410 table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: .95em; }
#p410 th, #p410 td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--p410-line); white-space: nowrap; }
#p410 th { font-weight: 600; color: var(--p410-muted); font-size: .85em; text-transform: uppercase; letter-spacing: .04em; }
#p410 td.mono { font-family: monospace; }
#p410 .ok { color: #3fb950; } #p410 .bad { color: #f85149; } #p410 .warn { color: #d29922; }
#p410 .tag { display: inline-block; padding: 1px 6px; border-radius: 4px; border: 1px solid var(--p410-line); font-size: .85em; }
#p410 .tag.unassigned { border-color: #d29922; color: #d29922; }
#p410 .tag.unraid { border-color: #3fb950; color: #3fb950; }
#p410 button.p410-btn { margin: 0 4px 0 0; padding: 2px 8px; min-width: 0; font-size: .85em; }
#p410 .p410-scroll { overflow-x: auto; }
#p410 .p410-msg { margin: 8px 0; white-space: pre-wrap; }
#p410 .p410-form { display: grid; grid-template-columns: max-content minmax(160px, 320px); gap: 6px 14px; align-items: center; margin-top: 10px; }
#p410 .p410-form input, #p410 .p410-form select { margin: 0; width: 100%; box-sizing: border-box; }
@media (max-width: 600px) { #p410 .p410-form { grid-template-columns: 1fr; } }
#p410-modal { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: none; z-index: 10000; align-items: center; justify-content: center; }
#p410-modal .box { background: var(--background-color, #1c1c1c); color: inherit; width: min(1000px, 94vw); max-height: 86vh; display: flex; flex-direction: column; border-radius: 8px; border: 1px solid rgba(127,127,127,.4); }
#p410-modal .bar { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-bottom: 1px solid rgba(127,127,127,.3); }
#p410-modal pre { margin: 0; padding: 12px 14px; overflow: auto; font-size: 12px; }
</style>

<div id="p410">
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
    <button type="button" onclick="p410Load()"><i class="fa fa-refresh"></i> <?=p410_h('js_refresh')?></button>
    <span id="p410-status" class="p410-msg"></span>
  </div>
  <div id="p410-root"><?=p410_h('js_loading')?></div>

  <div class="p410-card" id="p410-mon">
    <div class="p410-head"><h3><?=p410_h('js_mon_title')?></h3><span id="p410-last" class="p410-kv"></span></div>
    <div class="p410-form">
      <label><?=p410_h('f_lang')?></label><select name="LANG"><option value="auto"><?=p410_h('f_lang_auto')?></option><option value="en">English</option><option value="pl">Polski</option></select>
      <label><?=p410_h('f_mon')?></label><?=p410_onoff('MON_ENABLED')?>
      <label><?=p410_h('f_interval')?></label><input name="INTERVAL" type="number" min="5" max="1440">
      <label><?=p410_h('f_temp')?></label><input name="TEMP_WARN" type="number" min="30" max="70">
      <label><?=p410_h('f_standby')?></label><?=p410_yn('SKIP_STANDBY')?>
      <label><?=p410_h('f_ign_cache')?></label><?=p410_yn('IGNORE_CACHE', false)?>
      <label><?=p410_h('f_ign_batt')?></label><?=p410_yn('IGNORE_BATTERY', false)?>
      <label><?=p410_h('f_notify')?></label><?=p410_yn('NOTIFY')?>
      <label><?=p410_h('f_mqtt')?></label><?=p410_onoff('MQTT_ENABLED')?>
      <label><?=p410_h('f_host')?></label><input name="MQTT_HOST" placeholder="<?=p410_h('f_host_ph')?>">
      <label><?=p410_h('f_port')?></label><input name="MQTT_PORT" type="number" min="1" max="65535">
      <label><?=p410_h('f_user')?></label><input name="MQTT_USER" autocomplete="off">
      <label><?=p410_h('f_pass')?></label><input name="MQTT_PASS" type="password" autocomplete="new-password">
      <label><?=p410_h('f_topic')?></label><input name="MQTT_TOPIC">
      <label><?=p410_h('f_disc')?></label><?=p410_yn('MQTT_DISCOVERY')?>
      <label><?=p410_h('f_disc_prefix')?></label><input name="MQTT_DISCOVERY_PREFIX">
    </div>
    <div style="margin-top:10px">
      <button type="button" onclick="p410SaveCfg()"><i class="fa fa-save"></i> <?=p410_h('b_save')?></button>
      <button type="button" onclick="p410TestMqtt()"><i class="fa fa-plug"></i> <?=p410_h('b_test')?></button>
      <button type="button" onclick="p410RunCheck()"><i class="fa fa-stethoscope"></i> <?=p410_h('b_check')?></button>
      <button type="button" onclick="p410ResetBaseline()" title="<?=p410_h('b_baseline_t')?>"><i class="fa fa-undo"></i> <?=p410_h('b_baseline')?></button>
    </div>
    <div id="p410-check" class="p410-msg"></div>
  </div>
</div>

<div id="p410-modal" onclick="if(event.target===this)p410Close()">
  <div class="box">
    <div class="bar"><strong id="p410-modal-title">SMART</strong><button type="button" onclick="p410Close()"><?=p410_h('js_close')?></button></div>
    <pre id="p410-modal-text"></pre>
  </div>
</div>

<script>
const P410_URL  = '/plugins/p410mgr/include/exec.php';
const P410_CSRF = '<?=$var['csrf_token']?>';
const P410_T    = <?=json_encode(p410_js_dict(), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_APOS)?>;
const P410_LANG = '<?=p410_lang()?>';

function T(k, ...a){ let s = P410_T[k] ?? k; a.forEach(v => { s = s.replace('%s', v); }); return s; }
function p410Esc(s){ return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function p410Cls(st){ st = String(st||'').toLowerCase(); if (st === 'ok') return 'ok'; if (!st) return ''; return /fail|error|missing|not|predict/.test(st) ? 'bad' : 'warn'; }

async function p410Post(data){
  const body = new URLSearchParams(Object.assign({csrf_token: P410_CSRF}, data));
  const r = await fetch(P410_URL, {method:'POST', body, credentials:'same-origin'});
  const t = await r.text();
  try { return JSON.parse(t); } catch(e){ return {ok:false, msg: T('js_bad_resp') + '\n' + t.slice(0, 500)}; }
}

function p410Msg(text, ok){ const el = document.getElementById('p410-status'); el.className = 'p410-msg ' + (ok === false ? 'bad' : ok ? 'ok' : ''); el.textContent = text || ''; }

async function p410Load(){
  p410Msg(T('js_reading'));
  const r = await p410Post({action:'status'});
  if (!r.ok || r.error){ p410Msg(r.error || r.msg || T('js_error'), false); document.getElementById('p410-root').innerHTML=''; return; }
  document.getElementById('p410-root').innerHTML = r.controllers.map(p410RenderCtrl).join('');
  p410Msg(T('js_read_at', new Date().toLocaleTimeString(P410_LANG)));
}

function p410RenderCtrl(c){
  const d = c.detail || {};
  const keys = ['Controller Status','Firmware Version','Cache Status','Total Cache Size','Accelerator Ratio','Battery/Capacitor Count','Battery/Capacitor Status','Controller Temperature (C)','Drive Write Cache','No-Battery Write Cache'];
  const kv = keys.filter(k => d[k] !== undefined).map(k => `<span class="p410-kv"><span>${p410Esc(k)}:</span><b class="${/Status/.test(k)?p410Cls(d[k]):''}">${p410Esc(d[k])}</b></span>`).join('');
  const ldMap = {}; (c.lds||[]).forEach(l => ldMap[l.ld] = l);
  const ctrlCacheOk = /^ok$/i.test(d['Cache Status'] || '');
  const rows = (c.pds||[]).map(p => {
    const ld = p.lds && p.lds.length ? ldMap[p.lds[0]] : null;
    const pdA = p410Esc(p.pd), s = p410Esc(c.slot);
    let acts = `<button class="p410-btn" type="button" title="${p410Esc(T('js_led_on_t'))}" onclick="p410Led('${s}','${pdA}','on')"><i class="fa fa-lightbulb-o"></i> ${p410Esc(T('js_led_on'))}</button>`
             + `<button class="p410-btn" type="button" title="${p410Esc(T('js_led_off_t'))}" onclick="p410Led('${s}','${pdA}','off')"><i class="fa fa-circle-o"></i> ${p410Esc(T('js_led_off'))}</button>`
             + `<button class="p410-btn" type="button" onclick="p410Smart('${s}','${pdA}')"><i class="fa fa-heartbeat"></i> SMART</button>`;
    if (p.unassigned) acts += `<button class="p410-btn" type="button" onclick="p410Create('${s}','${pdA}')"><i class="fa fa-plus"></i> ${p410Esc(T('js_create'))}</button>`;
    if (ld){
      const inUse = !!ld.unraid;
      acts += `<button class="p410-btn" type="button" ${inUse ? 'disabled title="' + p410Esc(T('js_in_unraid')) + '"' : ''} onclick="p410Delete('${s}','${p410Esc(ld.ld)}','${p410Esc(ld.dev)}')"><i class="fa fa-trash"></i> ${p410Esc(T('js_delete'))}</button>`;
      if (/disabled/i.test(ld.caching)) {
        acts += ctrlCacheOk
          ? `<button class="p410-btn" type="button" onclick="p410Cache('${s}','${p410Esc(ld.ld)}','enable')"><i class="fa fa-bolt"></i> ${p410Esc(T('js_cache_on'))}</button>`
          : `<button class="p410-btn" type="button" disabled title="${p410Esc(T('js_cache_off_t', d['Cache Status'] || '?'))}"><i class="fa fa-bolt"></i> ${p410Esc(T('js_cache_on'))}</button>`;
      }
    }
    const unraid = p.unassigned ? '<span class="tag unassigned">unassigned</span>'
                 : ld && ld.unraid ? `<span class="tag unraid">${p410Esc(ld.unraid)}</span>` : '<span class="tag">—</span>';
    return `<tr>
      <td>${p.bay ?? ''}</td><td class="mono">${pdA}</td><td>${p410Esc(p.type)}</td><td>${p410Esc(p.size)}</td>
      <td>${p410Esc(p.model)}</td><td class="mono">${p410Esc(p.serial)}</td>
      <td>${p.temp ? p410Esc(p.temp)+' °C' : ''}</td><td class="${p410Cls(p.status)}">${p410Esc(p.status)}</td>
      <td>${ld ? 'LD '+p410Esc(ld.ld)+' <span style="opacity:.7">('+p410Esc(ld.raid)+', <span class="'+p410Cls(ld.status)+'">'+p410Esc(ld.status)+'</span>)</span>' : ''}</td>
      <td class="mono">${ld ? p410Esc(ld.dev) + (ld.dev && !ld.present ? ' <span class="warn" title="' + p410Esc(T('js_detached_t')) + '">(' + p410Esc(T('js_detached')) + ')</span>' : '') : ''}</td>
      <td>${ld ? p410Esc(ld.caching) : ''}</td>
      <td>${unraid}</td><td>${acts}</td></tr>`;
  }).join('');
  const th = ['js_bay','js_drive','js_type','js_size','js_model','js_serial','js_temp','js_state','js_volume','js_cache','js_unraid','js_actions'].map(k => `<th>${p410Esc(T(k))}</th>`);
  th.splice(9, 0, '<th>/dev</th>');
  return `<div class="p410-card">
    <div class="p410-head"><h3>${p410Esc(c.model)} — slot ${p410Esc(c.slot)}</h3>${kv}</div>
    <div class="p410-scroll"><table>
      <thead><tr>${th.join('')}</tr></thead>
      <tbody>${rows || '<tr><td colspan="13">' + p410Esc(T('js_no_drives')) + '</td></tr>'}</tbody>
    </table></div></div>`;
}

async function p410Led(slot, pd, state){ const r = await p410Post({action:'led', slot, pd, state}); p410Msg(r.msg, r.ok); }

async function p410Smart(slot, pd){
  p410Msg(T('js_smart_read', pd));
  const r = await p410Post({action:'smart', slot, pd});
  if (!r.ok){ p410Msg(r.msg, false); return; }
  p410Msg('');
  document.getElementById('p410-modal-title').textContent = 'SMART ' + pd + ' — ' + r.msg;
  document.getElementById('p410-modal-text').textContent = r.text;
  document.getElementById('p410-modal').style.display = 'flex';
}
function p410Close(){ document.getElementById('p410-modal').style.display = 'none'; }

async function p410Create(slot, pd){
  if (!confirm(T('js_create_q', pd))) return;
  p410Msg(T('js_creating'));
  const r = await p410Post({action:'create', slot, pd});
  p410Msg(r.msg, r.ok); if (r.ok) p410Load();
}

async function p410Delete(slot, ld, dev){
  const v = prompt(T('js_delete_q', ld, dev ? ' (' + dev + ')' : '', ld));
  if (v === null) return;
  if (v.trim() !== String(ld)){ p410Msg(T('js_cancelled'), false); return; }
  p410Msg(T('js_deleting'));
  const r = await p410Post({action:'delete', slot, ld, confirm: v.trim()});
  p410Msg(r.msg, r.ok); if (r.ok) p410Load();
}

async function p410Cache(slot, ld, state){ const r = await p410Post({action:'cache', slot, ld, state}); p410Msg(r.msg, r.ok); if (r.ok) p410Load(); }

function p410RenderCheck(st){
  const el = document.getElementById('p410-check'), last = document.getElementById('p410-last');
  if (!st){ last.innerHTML = '<span>' + p410Esc(T('js_last')) + '</span><b>' + p410Esc(T('js_never')) + '</b>'; el.textContent = ''; return; }
  last.innerHTML = '<span>' + p410Esc(T('js_last')) + '</span><b>' + p410Esc(new Date(st.ts).toLocaleString(P410_LANG)) + '</b> '
    + (st.problem ? '<b class="bad">' + p410Esc(T('js_problems', st.problems.length)) + '</b>' : '<b class="ok">OK</b>')
    + (st.mqtt ? ' <span>MQTT:</span><b class="' + (st.mqtt === 'OK' ? 'ok' : 'bad') + '">' + p410Esc(st.mqtt) + '</b>' : '');
  el.className = 'p410-msg ' + (st.problem ? 'bad' : '');
  el.textContent = st.problem ? st.problems.join('\n') : '';
}
async function p410LoadCfg(){
  const r = await p410Post({action:'getcfg'}); if (!r.ok) return;
  document.querySelectorAll('#p410-mon [name]').forEach(e => { if (r.cfg[e.name] !== undefined) e.value = r.cfg[e.name]; });
  const s = await p410Post({action:'laststate'}); if (s.ok) p410RenderCheck(s.state);
}
async function p410SaveCfg(){
  const d = {action:'savecfg'};
  const oldLang = P410_LANG;
  document.querySelectorAll('#p410-mon [name]').forEach(e => d['cfg[' + e.name + ']'] = e.value);
  const r = await p410Post(d); p410Msg(r.msg, r.ok);
  if (r.ok && d['cfg[LANG]'] !== 'auto' && d['cfg[LANG]'] !== oldLang) { location.reload(); return; }
  if (r.ok) p410LoadCfg();
}
async function p410TestMqtt(){ p410Msg(T('js_test_run')); const r = await p410Post({action:'testmqtt'}); p410Msg(r.msg, r.ok); }
async function p410RunCheck(){
  p410Msg(T('js_checking'));
  const r = await p410Post({action:'runcheck'});
  if (!r.ok){ p410Msg(r.msg, false); return; }
  p410RenderCheck(r.state); p410Msg(T('js_check_done'), !r.state.problem);
}
async function p410ResetBaseline(){
  if (!confirm(T('js_baseline_q'))) return;
  const r = await p410Post({action:'resetbaseline'}); p410Msg(r.msg, r.ok);
}

p410Load();
p410LoadCfg();
</script>
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/p410mgr/P410mgrDash.page">
<INLINE><![CDATA[
Menu="Dashboard:0"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.12.0-beta6','>')"
---
<?PHP
require_once '/usr/local/emhttp/plugins/p410mgr/include/i18n.php';
$p410_csrf = htmlspecialchars($var['csrf_token'] ?? '', ENT_QUOTES);
$p410_dict = json_encode(p410_js_dict(), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_APOS);
$p410_open = htmlspecialchars(p410_t('d_open'), ENT_QUOTES);
$p410_ld   = htmlspecialchars(p410_t('js_loading'), ENT_QUOTES);
$mytiles['p410mgr']['column2'] = <<<EOT
<tbody id="db-p410mgr" title="Smart Array P410">
<tr><td>
  <i class="fa fa-hdd-o f32"></i>
  <div class="section">Smart Array P410<br><span id="p410db-sub">$p410_ld</span><br></div>
  <a href="/Settings/P410mgr" title="$p410_open"><i class="fa fa-fw fa-cog control"></i></a>
</td></tr>
<tr><td><div id="p410db-body" style="line-height:1.7"></div></td></tr>
</tbody>
<script>var P410DB_CSRF="$p410_csrf"; var P410DB_T=$p410_dict;</script>
EOT;
$mytiles['p410mgr']['column2'] .= <<<'EOT'
<script>
(function(){
  const URL = '/plugins/p410mgr/include/exec.php';
  const T = k => (typeof P410DB_T !== 'undefined' && P410DB_T[k]) || k;
  const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const col = s => /^ok$/i.test(s||'') ? '#3fb950' : (/fail|error/i.test(s||'') ? '#f85149' : '#d29922');
  async function load(){
    let r;
    try {
      const body = new URLSearchParams({csrf_token: (typeof P410DB_CSRF!=='undefined' && P410DB_CSRF) || (typeof csrf_token!=='undefined' ? csrf_token : ''), action:'summary'});
      const res = await fetch(URL, {method:'POST', body, credentials:'same-origin'});
      r = await res.json();
    } catch(e){ r = {ok:false, msg: T('d_no_resp')}; }
    const sub = document.getElementById('p410db-sub'), el = document.getElementById('p410db-body');
    if (!sub || !el) return;
    if (!r.ok){ sub.innerHTML = '<span style="color:#f85149">' + esc(T('js_error')) + '</span>'; el.textContent = r.msg || ''; return; }
    const allOk = r.controllers.every(c => /^ok$/i.test(c.ctrl) && (c.ign_cache || /^ok$/i.test(c.cache)) && (c.ign_battery || /^ok$|^—$/i.test(c.battery)) && !c.bad.length);
    sub.innerHTML = allOk ? '<span style="color:#3fb950">' + esc(T('d_all_ok')) + '</span>' : '<span style="color:#d29922">' + esc(T('d_attention')) + '</span>';
    const ign = (v, flag) => flag && !/^ok$/i.test(v) ? [v + ' (' + T('d_ignored') + ')', '#8b949e'] : [v, col(v)];
    el.innerHTML = r.controllers.map(c => {
      const row = (k, v, color) => `<div style="display:flex;justify-content:space-between;gap:12px"><span style="opacity:.75">${esc(k)}</span><span${color?` style="color:${color}"`:''}>${esc(v)}</span></div>`;
      const [cv, cc] = ign(c.cache, c.ign_cache), [bv, bc] = ign(c.battery, c.ign_battery);
      return `<div style="font-weight:600;margin-bottom:2px">${esc(c.model)} (slot ${esc(c.slot)})</div>`
        + row(T('d_controller'), c.ctrl, col(c.ctrl))
        + row(T('d_cache'), cv, cc)
        + row(T('d_battery'), bv, bc)
        + row(T('d_drives'), `${c.pds} / ${c.lds}` + (c.unassigned ? ` (${c.unassigned} unassigned)` : ''))
        + row(T('d_maxtemp'), c.tmax !== null ? c.tmax + ' °C' : '—', c.tmax >= 45 ? '#f85149' : (c.tmax >= 40 ? '#d29922' : ''))
        + (c.bad.length ? `<div style="color:#f85149;margin-top:4px">${c.bad.map(esc).join('<br>')}</div>` : '');
    }).join('<hr style="opacity:.2">');
  }
  load();
  setInterval(() => { if (!document.hidden) load(); }, 60000);
})();
</script>
EOT;
?>
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/p410mgr/include/i18n.php">
<INLINE><![CDATA[
<?php
/* p410mgr — tłumaczenia / translations (EN default, PL) */

function p410_lang(): string {
  static $lang = null;
  if ($lang !== null) return $lang;
  $cfg = @parse_ini_file('/boot/config/plugins/p410mgr/p410mgr.cfg', false, INI_SCANNER_RAW) ?: [];
  $sel = $cfg['LANG'] ?? 'auto';
  if ($sel === 'en' || $sel === 'pl') return $lang = $sel;
  $dyn = @parse_ini_file('/boot/config/plugins/dynamix/dynamix.cfg', true, INI_SCANNER_RAW) ?: [];
  $loc = $dyn['display']['locale'] ?? '';
  return $lang = (stripos($loc, 'pl') === 0) ? 'pl' : 'en';
}

